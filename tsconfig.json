{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": [
      "node",
      "bun-types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "nodes/**/*.ts",
    "credentials/**/*.ts",
    "index.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}